# Keep secrets private; do not commit .env or paste keys into chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel

# Free OpenRouter model; with FREE_ONLY=true paid models are blocked.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=
FREE_ONLY=true

# Optional: broader YouTube search. Without it, chosen channel feeds are used.
YOUTUBE_API_KEY=
# Optional: fallback when direct caption retrieval fails. Native captions only.
SUPADATA_API_KEY=
SUPADATA_DAILY_CAP=3
SUPADATA_MONTHLY_CAP=75

TZ=Asia/Tehran
DAILY_TIME=09:05
LOOKBACK_HOURS=48
MAX_ARTICLES=6
MAX_VIDEOS=2
MAX_TRANSCRIPT_CHUNKS=5
MAX_LLM_CALLS_PER_DAY=32
LLM_MIN_INTERVAL_SECONDS=3.5
TELEGRAM_SILENT=false
